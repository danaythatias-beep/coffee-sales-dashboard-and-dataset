          }
        ]
      }
    },
    {
      "name": "sales_forecast",
      "displayName": "Sales Forecast Data",
      "queryLines": [
        "WITH historical_sales AS (\n",
        "  SELECT\n",
        "    DATE(datetime) as date,\n",
        "    SUM(money_amount) as daily_sales\n",
        "  FROM\n",
        "    workspace.default.coffee_sales\n",
        "  GROUP BY\n",
        "    DATE(datetime)\n",
        "),\n",
        "forecast_result AS (\n",
        "  SELECT\n",
        "    date,\n",
        "    daily_sales as actual_sales,\n",
        "    AI_FORECAST(daily_sales, date, date) OVER (\n",
        "        ORDER BY date\n",
        "        ROWS BETWEEN 30 PRECEDING AND 30 FOLLOWING\n",
        "      ) as forecast\n",
        "  FROM\n",
        "    historical_sales\n",
        ")\n",
        "SELECT\n",
        "  date,\n",
        "  actual_sales,\n",
        "  forecast.forecast as forecasted_sales,\n",
        "  forecast.prediction_interval_lower_bound as lower_bound,\n",
        "  forecast.prediction_interval_upper_bound as upper_bound\n",
        "FROM\n",
        "  forecast_result"
      ]
    },
    {
      "name": "forecast_kpis",
      "displayName": "Forecast KPIs",
      "queryLines": [
        "WITH historical_sales AS (\n",
        "  SELECT\n",
        "    DATE(datetime) as date,\n",
        "    SUM(money_amount) as daily_sales\n",
        "  FROM\n",
        "    workspace.default.coffee_sales\n",
        "  GROUP BY\n",
        "    DATE(datetime)\n",
        "),\n",
        "max_date AS (\n",
        "  SELECT\n",
        "    MAX(date) as last_date\n",
        "  FROM\n",
        "    historical_sales\n",
        "),\n",
        "forecast_data AS (\n",
        "  SELECT\n",
        "    date,\n",
        "    daily_sales,\n",
        "    AI_FORECAST(\n",
        "      daily_sales,\n",
        "      date,\n",
        "      (\n",
        "        SELECT\n",
        "          last_date + INTERVAL 30 DAY\n",
        "        FROM\n",
        "          max_date\n",
        "      )\n",
        "    ) OVER (ORDER BY date ROWS BETWEEN 30 PRECEDING AND 30 FOLLOWING) as forecast\n",
        "  FROM\n",
        "    historical_sales\n",
        "),\n",
        "future_forecasts AS (\n",
        "  SELECT\n",
        "    forecast.forecast as forecasted_sales,\n",
        "    forecast.forecast_timestamp as forecast_date\n",
        "  FROM\n",
        "    forecast_data CROSS JOIN UNNEST(forecast) as forecast\n",
        "  WHERE\n",
        "    forecast.forecast_timestamp\n",
        "      > (\n",
        "        SELECT\n",
        "          last_date\n",
        "        FROM\n",
        "          max_date\n",
        "      )\n",
        ")\n",
        "SELECT\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        forecast_date\n",
        "          = (\n",
        "            SELECT\n",
        "              last_date + INTERVAL 1 DAY\n",
        "            FROM\n",
        "              max_date\n",
        "          )\n",
        "      THEN\n",
        "        forecasted_sales\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as next_day_forecast,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        forecast_date BETWEEN\n",
        "          (\n",
        "            SELECT\n",
        "              last_date + INTERVAL 1 DAY\n",
        "            FROM\n",
        "              max_date\n",
        "          )\n",
        "        AND\n",
        "          (\n",
        "            SELECT\n",
        "              last_date + INTERVAL 7 DAY\n",
        "            FROM\n",
        "              max_date\n",
        "          )\n",
        "      THEN\n",
        "        forecasted_sales\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as next_week_forecast,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        forecast_date BETWEEN\n",
        "          (\n",
        "            SELECT\n",
        "              last_date + INTERVAL 1 DAY\n",
        "            FROM\n",
        "              max_date\n",
        "          )\n",
        "        AND\n",
        "          (\n",
        "            SELECT\n",
        "              last_date + INTERVAL 30 DAY\n",
        "            FROM\n",
        "              max_date\n",
        "          )\n",
        "      THEN\n",
        "        forecasted_sales\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as next_month_forecast\n",
        "FROM\n",
        "  future_forecasts"
      ]
    },
    {
      "name": "customer_stats",
      "displayName": "Customer Statistics",
      "queryLines": [
        "WITH customer_purchases AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    COUNT(*) as purchase_count,\n",
        "    SUM(money_amount) as total_spending\n",
        "  FROM\n",
        "    workspace.default.coffee_sales\n",
        "  GROUP BY\n",
        "    customer_id\n",
        ")\n",
        "SELECT\n",
        "  COUNT(DISTINCT customer_id) as total_customers,\n",
        "  COUNT(DISTINCT\n",
        "    CASE\n",
        "      WHEN purchase_count > 1 THEN customer_id\n",
        "    END\n",
        "  ) as repeat_customers,\n",
        "  AVG(total_spending) as avg_spending_per_customer,\n",
        "  MAX(total_spending) as highest_spending\n",
        "FROM\n",
        "  customer_purchases"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "Top Customers",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  SUM(money_amount) as total_spending\n",
        "FROM\n",
        "  workspace.default.coffee_sales\n",
        "GROUP BY\n",
        "  customer_id\n",
        "ORDER BY\n",
        "  total_spending DESC"
      ]
    },
    {
      "name": "coffee_by_segment",
      "displayName": "Favorite Coffee by Segment",
      "queryLines": [
        "WITH customer_segment AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    CASE\n",
        "      WHEN COUNT(*) = 1 THEN 'New'\n",
        "      ELSE 'Repeat'\n",
        "    END as segment\n",
        "  FROM\n",
        "    workspace.default.coffee_sales\n",
        "  GROUP BY\n",
        "    customer_id\n",
        ")\n",
        "SELECT\n",
        "  cs.segment,\n",
        "  c.coffee_name,\n",
        "  COUNT(*) as order_count\n",
        "FROM\n",
        "  workspace.default.coffee_sales c\n",
        "    JOIN customer_segment cs\n",
        "      ON c.customer_id = cs.customer_id\n",
        "GROUP BY\n",
        "  cs.segment,\n",
        "  c.coffee_name\n",
        "ORDER BY\n",
        "  cs.segment,\n",
        "  order_count DESC"
      ]
    },
    {
      "name": "spending_vs_frequency",
      "displayName": "Spending vs Purchase Frequency",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  COUNT(*) as purchase_frequency,\n",
        "  SUM(money_amount) as total_spending\n",
        "FROM\n",
        "  workspace.default.coffee_sales\n",
        "GROUP BY\n",
        "  customer_id"
      ]
    },
    {
      "name": "purchase_frequency",
      "displayName": "Purchase Frequency Distribution",
      "queryLines": [
        "WITH customer_purchases AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    COUNT(*) as purchase_count\n",
        "  FROM\n",
        "    workspace.default.coffee_sales\n",
        "  GROUP BY\n",
        "    customer_id\n",
        ")\n",
        "SELECT\n",
        "  purchase_count,\n",
        "  COUNT(*) as customer_count\n",
        "FROM\n",
        "  customer_purchases\n",
        "GROUP BY\n",
        "  purchase_count\n",
        "ORDER BY\n",
        "  purchase_count"
      ]
    },
    {
      "name": "customer_segment",
      "displayName": "Customer Segmentation",
      "queryLines": [
        "WITH customer_purchases AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    COUNT(*) as purchase_count,\n",
        "    CASE\n",
        "      WHEN COUNT(*) = 1 THEN 'New Customer'\n",
        "      ELSE 'Repeat Customer'\n",
        "    END as customer_type\n",
        "  FROM\n",
        "    workspace.default.coffee_sales\n",
        "  GROUP BY\n",
        "    customer_id\n",
        ")\n",
        "SELECT\n",
        "  customer_type,\n",
        "  COUNT(*) as customer_count\n",
        "FROM\n",
        "  customer_purchases\n",
        "GROUP BY\n",
        "  customer_type"
      ]
    }
